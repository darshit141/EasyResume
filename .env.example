SECRET_KEY=django-insecure-change-this
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# Local Ollama LLM settings
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# Optional: Docker Compose stores SQLite in its persistent backend-data volume.
# Leave unset for local development to use ./db.sqlite3.
SQLITE_DB_PATH=

# JWT Settings
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=7
