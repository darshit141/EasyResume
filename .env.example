SECRET_KEY=django-insecure-change-this
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres. Required in docker-compose.yml (postgres service reads these
# too). Leave DATABASE_URL unset for local, non-Docker development to fall
# back to a repository-local SQLite file — never use SQLite in production.
POSTGRES_DB=intelliresume
POSTGRES_USER=intelliresume
POSTGRES_PASSWORD=change-this
DATABASE_URL=

# Redis: Celery broker/result backend for every AI-backed background job
# (see ai_jobs/), and the shared cache production rate-limiting should use.
REDIS_URL=redis://localhost:6379/0

# AI provider settings. LLM_PROVIDER is the server-wide default
# (ollama | groq | gemini); requests may override it per-call with their
# own ai_provider choice. Defaults to a hosted provider (groq) — CPU-only
# Ollama cannot serve concurrent paying traffic. Set LLM_PROVIDER=ollama to
# use the self-hosted profile instead (`docker compose --profile
# self-hosted-ai up`).
LLM_PROVIDER=groq
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
# When set to a different provider, an outage of LLM_PROVIDER automatically
# retries once against this one before failing the request. Empty by
# default — costs against a second provider's quota/API key once set.
LLM_FALLBACK_PROVIDER=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local (non-Docker) development only — ignored once DATABASE_URL is set.
SQLITE_DB_PATH=

# JWT Settings
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=7

# Stripe. Empty by default — billing endpoints return a clean
# STRIPE_NOT_CONFIGURED error rather than crashing until real keys are set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Requires Stripe Tax enabled in the Stripe Dashboard first, or checkout
# fails outright — leave False until that's done.
STRIPE_AUTOMATIC_TAX_ENABLED=False

# Pro plan pricing (see billing/plans.py for the full reasoning) — this is
# the adopted launch pricing, not a placeholder. Each Stripe Price ID must
# be created per currency/period in the Stripe Dashboard (test vs. live
# mode have different ids); until set, that specific combination can't be
# checked out.
PRO_PRICE_EUR_MONTHLY_CENTS=1499
PRO_PRICE_EUR_ANNUAL_CENTS=11900
PRO_PRICE_GBP_MONTHLY_CENTS=1299
PRO_PRICE_GBP_ANNUAL_CENTS=9900
STRIPE_PRICE_ID_PRO_EUR_MONTHLY=
STRIPE_PRICE_ID_PRO_EUR_ANNUAL=
STRIPE_PRICE_ID_PRO_GBP_MONTHLY=
STRIPE_PRICE_ID_PRO_GBP_ANNUAL=

# Object storage for uploaded resumes. Empty by default — files are written
# to a local ./media directory, which is fine for local dev but is wiped on
# every deploy on most PaaS hosts (Render, Railway, Heroku, Fly.io) and
# isn't shared across multiple app instances. Set AWS_STORAGE_BUCKET_NAME to
# switch to S3-compatible storage with no code changes; AWS_S3_ENDPOINT_URL
# is only needed for a non-AWS provider (Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces, MinIO) — leave it unset for real AWS S3.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=3600

# Observability. Logging works with no setup (JSON to stdout in
# production, readable plain text in dev — see config/settings.py
# LOGGING). Sentry is a no-op until SENTRY_DSN is set — get one at
# https://sentry.io (or a self-hosted instance) by creating a Django
# project.
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Sign in with Google. The OAuth 2.0 *Web application* client id from the
# Google Cloud console. Every incoming Google ID token's audience is checked
# against this exact value - a mismatch (or an empty value) rejects every
# Google sign-in with a clear 503, and the frontend shows only the password
# form. Must match the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=661107487562-5us1vvco9nb8nau9k9b35ts4bcngn85j.apps.googleusercontent.com
# Comma-separated extra audiences - only needed once the Chrome extension
# has its own OAuth client (different redirect type). Each is matched exactly.
GOOGLE_OAUTH_EXTRA_CLIENT_IDS=
