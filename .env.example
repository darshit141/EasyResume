# IntelliResume backend environment.
#
# Copy to .env and fill in. Every variable the code reads is listed here with
# the code's own default (a test - api/tests_env_example.py - fails if one is
# missing). Rules this file follows, because a wrong blank is worse than a
# missing line:
#
#   - `NAME=value`  the code's default; change it or leave it.
#   - `NAME=`       blank is the same as unset (keys, ids, optional URLs).
#   - `# NAME=`     optional, and a blank value would CHANGE behaviour, so it
#                   stays commented out until you actually set it.
#
# Many AI, limits and ads settings can also be changed at runtime in the admin
# Configuration tab. A value saved there beats this file and needs no restart;
# `python manage.py check_ai` shows which source each AI setting comes from.

# --- Core -----------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this
DEBUG=True

# Private path for the Django admin site in production (default: admin/).
# DJANGO_ADMIN_URL=
# Swagger UI and OpenAPI schema at /api/docs/ and /api/schema/.
# Defaults to the value of DEBUG, so they are off in production.
# API_DOCS_ENABLED=False
ALLOWED_HOSTS=127.0.0.1,localhost
# Production only (ignored while DEBUG=True wide-opens CORS). Comma-separated.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# CRITICAL for AdSense sitemap! Used to generate all URLs in sitemap.xml
# and for Stripe redirects. For production use: https://intelliresume.online
FRONTEND_URL=http://localhost:5173
# Encrypts API keys saved in the admin Configuration tab. Set it once, before
# the first deploy that includes migration api.0004, and never change it -
# a different value makes stored keys unreadable. Falls back to a key derived
# from SECRET_KEY. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONFIG_ENCRYPTION_KEY=

# --- HTTPS hardening (only applies when DEBUG=False) ----------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Database -------------------------------------------------------------------
# Postgres. The postgres service in docker-compose reads POSTGRES_* too. Leave
# DATABASE_URL blank for local, non-Docker development to use SQLite - never
# use SQLite in production.
POSTGRES_DB=intelliresume
POSTGRES_USER=intelliresume
POSTGRES_PASSWORD=change-this
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
# Local SQLite file path. Commented out on purpose: a blank value would make
# the database name empty and break startup. Default: db.sqlite3 in the repo.
# SQLITE_DB_PATH=

# --- Redis, cache and Celery ------------------------------------------------------
# Celery broker/result backend for every AI background job, and the shared
# cache rate-limiting uses.
REDIS_URL=redis://localhost:6379/0
# Seconds before a cache call to Redis gives up. With Redis down or
# unreachable, the app carries on without rate limiting instead of stalling
# every request.
REDIS_SOCKET_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=1
# Local runserver without Redis only - never in a multi-worker deployment.
# USE_LOCMEM_CACHE=true
# Run Celery tasks in-process instead of on a worker (local debugging only).
# CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# --- Auth ----------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=7
# Require an emailed one-time code after the password. Also an admin setting.
LOGIN_OTP_REQUIRED=True
# Sign-in security fallbacks. Each one is also editable live from the admin
# panel (Settings > Security); the admin value wins over these.
# Wrong passwords before an account is locked for a while (0 = never lock).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Wrong one-time codes allowed before the code is thrown away.
OTP_MAX_ATTEMPTS=5
OTP_EXPIRY_MINUTES=5
# Minimum gap before another emailed code is sent.
OTP_RESEND_COOLDOWN_SECONDS=60
# Let users protect sign-in with an authenticator app.
TOTP_2FA_ENABLED=True
# Name shown next to the account inside the authenticator app.
TOTP_ISSUER_NAME=IntelliResume
# Sign in with Google: the OAuth 2.0 *Web application* client id. Every Google
# ID token's audience is checked against it; must match the frontend's
# VITE_GOOGLE_CLIENT_ID. Public, not a secret.
GOOGLE_OAUTH_CLIENT_ID=661107487562-5us1vvco9nb8nau9k9b35ts4bcngn85j.apps.googleusercontent.com
# Comma-separated extra audiences, e.g. the Chrome extension's own OAuth client.
GOOGLE_OAUTH_EXTRA_CLIENT_IDS=

# --- AI providers ---------------------------------------------------------------
# First-boot defaults only: once running, the admin Configuration tab is the
# source of truth for provider, models, fallbacks and keys.
# LLM_PROVIDER: ollama | groq | gemini | kira
LLM_PROVIDER=groq
# Retried once when LLM_PROVIDER fails. Blank = no fallback.
LLM_FALLBACK_PROVIDER=
# Let users pick a provider per request. Off hides the picker and ignores
# any provider a client sends.
AI_PROVIDER_SELECTION_ENABLED=False
# Let users save their own Gemini API key and have their AI requests use it.
# While one is active the monthly AI-action limit stops applying to that user
# (it exists only to cap our provider bill); no paid feature is unlocked.
# Also switchable live from the admin Configuration tab.
BYOK_ENABLED=False
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
# Cap on generated tokens per call. Lower values truncate long JSON (a full
# tailored resume) and fail the request.
LLM_MAX_OUTPUT_TOKENS=8192

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Blank = pick from Google's live model list. A discontinued model is skipped
# automatically.
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models to try, in order, when the first choice fails.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-pro-latest
GEMINI_MODEL_DISCOVERY=True
# Automatic fallbacks must contain one of these words and none of the excluded ones.
GEMINI_AUTO_FALLBACK_FAMILIES=flash,pro
GEMINI_AUTO_EXCLUDE=image,tts,audio,transcribe,live,embedding,computer-use,robotics,customtools,research,antigravity,omni,preview,exp
GEMINI_MAX_MODEL_ATTEMPTS=8
GEMINI_MODEL_LIST_TTL=3600
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Dahl Global - https://inference.dahl.global/v1
# OpenAI-compatible API hosting MiniMaxAI/MiniMax-M2.7, zai-org/GLM-5.3-Flash, deepseek-ai/DeepSeek-V4-Flash-0731
DAHL_API_KEY=
DAHL_MODEL=MiniMaxAI/MiniMax-M2.7
DAHL_FALLBACK_MODELS=zai-org/GLM-5.3-Flash,deepseek-ai/DeepSeek-V4-Flash-0731
DAHL_BASE_URL=https://inference.dahl.global/v1

# Groq - https://console.groq.com/keys (check its current model list)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Kira (kiraai.vn) - OpenAI-compatible. No default model: set KIRA_MODEL if
# you use Kira, or readiness reports the model unavailable.
KIRA_API_KEY=
KIRA_MODEL=
KIRA_BASE_URL=https://kiraai.vn/api/v1

# OpenRouter - https://openrouter.ai/keys. Pro/Max only, see
# billing.entitlements.PRO_ENTITLEMENTS["allowed_ai_providers"]. Its free
# model roster changes often — check https://openrouter.ai/models?max_price=0
# for what's currently live rather than trusting an old model id here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Self-hosted Ollama (`docker compose --profile self-hosted-ai up`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_KEEP_ALIVE=30m

# --- Job links -------------------------------------------------------------------
# Import from any public site, including company career pages (the SSRF guards
# still apply). False = only ALLOWED_JOB_URL_DOMAINS below.
JOB_URL_ALLOW_ANY_PUBLIC_SITE=True
# Domains a job posting link may point at when the above is False. Commented
# out on purpose: the code ships a default list of major job boards, and an
# explicitly BLANK value disables the restriction entirely.
# ALLOWED_JOB_URL_DOMAINS=linkedin.com,indeed.com,greenhouse.io,lever.co
# Sites that block server requests: fail instantly instead of waiting.
# Commented out: the code ships the list verified from production.
# BOT_WALLED_JOB_DOMAINS=naukri.com,indeed.*,glassdoor.*,ziprecruiter.*,monster.*,wellfound.com,angel.co
JOB_IMPORT_TIME_BUDGET_SECONDS=8
JOB_IMPORT_CACHE_SECONDS=86400
JOB_IMPORT_ATTEMPT_RETENTION_DAYS=90
# Optional rescue for postings that render client-side. Blank = off.
APIFY_API_TOKEN=

# --- Plan limits (also admin settings) ---------------------------------------------
MAX_RESUMES_PER_USER=5
FREE_AI_CALLS_PER_MONTH=30
FREE_TAILORED_RESUMES_PER_MONTH=2
FREE_JOB_APPLICATIONS_PER_MONTH=10
PRO_JOB_APPLICATIONS_PER_MONTH=200
MAX_JOB_APPLICATIONS_PER_MONTH=500
# Free launch offer: all features free, checkout closed, AI metered per rolling
# window. Also switchable live in the admin Configuration tab (Limits).
LAUNCH_FREE_ACCESS=False
# Optional last day, YYYY-MM-DD. Empty = no end date.
LAUNCH_FREE_UNTIL=
LAUNCH_QUOTA_WINDOW_HOURS=12
LAUNCH_TAILORED_RESUMES_PER_WINDOW=3
LAUNCH_AI_CALLS_PER_WINDOW=15
LAUNCH_SHOW_ADS=True
# Site-wide AI actions per day for unpaid users (0 = off); ops emailed at the
# alert percent and at the cap. Day boundary is midnight in the time zone.
AI_GLOBAL_DAILY_CAP=1500
AI_CAPACITY_ALERT_PERCENT=80
AI_CAPACITY_TIME_ZONE=Asia/Kolkata
# Employer reply tracking: none | alias | gmail per plan.
REPLY_TRACKING_ENABLED=True
REPLY_TRACKING_FREE=alias
REPLY_TRACKING_PRO=alias
REPLY_TRACKING_MAX=gmail
# Jobs a Free account can track recruiter email for (paid plans: unlimited).
REPLY_TRACKING_FREE_JOB_LIMIT=5
# Receiving recruiter email (inbox app). Cloudflare Email Routing sends mail for
# this domain to the site's Worker, which signs it with INBOUND_EMAIL_SECRET
# (same value as the Worker's secret) and posts it to /api/inbox/inbound/.
INBOUND_EMAIL_DOMAIN=intelliresume.online
INBOUND_EMAIL_SECRET=
# Keep False until test mail has been received end to end.
INBOUND_EMAIL_ENABLED=False
INBOUND_EMAIL_MAX_BYTES=10485760
INBOUND_EMAIL_DAILY_LIMIT=200
INBOUND_EMAIL_RETENTION_DAYS=180
# Days after applying before the "did you hear back?" email.
OUTCOME_NUDGE_AFTER_DAYS=7

# --- Rate limits ------------------------------------------------------------------
THROTTLE_AUTH_SENSITIVE=10/min
THROTTLE_AI_RESUME=20/min
THROTTLE_ANALYTICS_TRACK=60/min
THROTTLE_B2B_LEAD=5/min
THROTTLE_FEEDBACK=5/min
THROTTLE_OUTCOME_RECORD=20/min
THROTTLE_APPLICATION_TRACKING=30/min
THROTTLE_AUTOFILL=20/min
# Saving a bring-your-own provider key calls that provider to validate it,
# so this endpoint could otherwise be used to test stolen keys from our IP.
THROTTLE_USER_AI_KEY=10/hour

# --- Email -------------------------------------------------------------------------
# Production sends through Resend's HTTPS API (DigitalOcean blocks outbound
# SMTP). With neither RESEND_API_KEY nor EMAIL_HOST set, email is printed to
# the server log instead of sent - OTP codes included.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL="IntelliResume <no-reply@intelliresume.local>"
# Direct Apply's sending address. Blank = DEFAULT_FROM_EMAIL.
APPLICATION_FROM_EMAIL=
# Operational alerts (the daily job-import check).
OPS_ALERT_EMAIL=sales@patrixel.com
# SMTP instead of Resend. Commented out: the numeric settings crash startup if blank.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10

# --- Legal ------------------------------------------------------------------------------
# Bump when the legal text changes (after counsel review) so acceptance
# records reflect what each user agreed to.
CURRENT_PRIVACY_POLICY_VERSION=2026-08-21
CURRENT_TERMS_OF_SERVICE_VERSION=2026-08-21
CURRENT_COOKIE_POLICY_VERSION=2026-08-21

# --- Stripe --------------------------------------------------------------------------
# Off for the India launch: only rupee checkout (Razorpay) is offered. Set True to
# bring back euro/pound checkout. Also switchable in the admin Payments section.
STRIPE_ENABLED=False
# Blank = billing endpoints return STRIPE_NOT_CONFIGURED instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Requires Stripe Tax enabled in the Dashboard first, or checkout fails.
STRIPE_AUTOMATIC_TAX_ENABLED=False
# Price ids per plan/currency/period (test and live mode differ). Until set,
# that combination can't be checked out.
STRIPE_PRICE_ID_PRO_EUR_MONTHLY=
STRIPE_PRICE_ID_PRO_EUR_ANNUAL=
STRIPE_PRICE_ID_PRO_GBP_MONTHLY=
STRIPE_PRICE_ID_PRO_GBP_ANNUAL=
STRIPE_PRICE_ID_MAX_EUR_MONTHLY=
STRIPE_PRICE_ID_MAX_EUR_ANNUAL=
STRIPE_PRICE_ID_MAX_GBP_MONTHLY=
STRIPE_PRICE_ID_MAX_GBP_ANNUAL=
# --- Razorpay (INR: UPI AutoPay, cards, e-mandate) -----------------------------------
# Stripe is invite-only for Indian businesses and offers them neither UPI nor
# Stripe Tax, so INR runs through Razorpay. Blank = INR checkout reports
# RAZORPAY_NOT_CONFIGURED. See RAZORPAY_SETUP.md. The key id/secret, webhook secret
# and the four plan ids can instead be entered in the admin Payments section
# (stored encrypted, no redeploy); a value saved there wins over this file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard -> Webhooks. Subscribe to the subscription.* events and
# refund.processed, pointing at /api/billing/razorpay/webhook/.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# Mandate term for a new subscription, in years.
RAZORPAY_SUBSCRIPTION_YEARS=10
# Razorpay Plan ids per plan/period (test and live mode differ). Each plan's
# amount must equal the INR price below, GST included.
RAZORPAY_PLAN_ID_PRO_INR_MONTHLY=
RAZORPAY_PLAN_ID_PRO_INR_ANNUAL=
RAZORPAY_PLAN_ID_MAX_INR_MONTHLY=
RAZORPAY_PLAN_ID_MAX_INR_ANNUAL=

# --- Indian GST (INR only; all also editable in the admin Configuration tab) ---------
# Leave False until the business holds a GSTIN: an unregistered supplier must
# not charge GST. INR prices are GST-inclusive either way, so turning this on
# changes the invoice breakdown, never the amount a customer pays.
GST_ENABLED=False
GST_RATE_PERCENT=18
GST_SELLER_GSTIN=
# Only needed when it can't be read from GST_SELLER_GSTIN.
GST_SELLER_STATE_CODE=
GST_SELLER_LEGAL_NAME=Patrixel Digital Solutions
GST_SELLER_ADDRESS=
# Services Accounting Code for the invoice. Confirm with your accountant.
GST_SAC_CODE=
# Up to four letters. Invoices are numbered PREFIX/2627/000001.
GST_INVOICE_PREFIX=IR

# Show the Max plan on the pricing page.
PUBLISH_MAX_PLAN=False
# Built-in prices in cents (admin-set prices and offers win over these).
PRO_PRICE_EUR_MONTHLY_CENTS=1499
PRO_PRICE_EUR_ANNUAL_CENTS=11900
PRO_PRICE_GBP_MONTHLY_CENTS=1299
PRO_PRICE_GBP_ANNUAL_CENTS=9900
MAX_PRICE_EUR_MONTHLY_CENTS=2999
MAX_PRICE_EUR_ANNUAL_CENTS=24900
MAX_PRICE_GBP_MONTHLY_CENTS=2499
MAX_PRICE_GBP_ANNUAL_CENTS=20900
# INR prices are in paise and include GST.
PRO_PRICE_INR_MONTHLY_CENTS=49900
PRO_PRICE_INR_ANNUAL_CENTS=399900
MAX_PRICE_INR_MONTHLY_CENTS=99900
MAX_PRICE_INR_ANNUAL_CENTS=799900

# --- Ads (also admin settings) -----------------------------------------------------------
DISPLAY_ADS_ENABLED=False
# adsense | admanager | none
DISPLAY_AD_PROVIDER=adsense
ADSENSE_CLIENT_ID=
DISPLAY_AD_UNIT_ARTICLE_TOP=
DISPLAY_AD_UNIT_ARTICLE_BOTTOM=
DISPLAY_AD_UNIT_BLOG_INDEX=
REWARDED_ADS_ENABLED=False
# admanager | partner
REWARDED_AD_PROVIDER=admanager
REWARDED_AD_CREDITS_PER_VIEW=1
REWARDED_AD_MAX_PER_DAY=3
REWARDED_AD_CREDIT_TTL_DAYS=7
GAM_NETWORK_CODE=
GAM_REWARDED_AD_UNIT_PATH=
PARTNER_REWARDED_SCRIPT_URL=
PARTNER_REWARDED_PLACEMENT_ID=
PARTNER_REWARDED_SHOW_FN=
PARTNER_REWARDED_S2S_SECRET=

# --- File storage --------------------------------------------------------------------------
# Blank = uploaded resumes go to local ./media, which is lost if the server is
# replaced and not shared between instances. Set a bucket for S3-compatible
# storage; AWS_S3_ENDPOINT_URL only for non-AWS providers (DigitalOcean
# Spaces, Cloudflare R2, Backblaze B2, MinIO).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=3600

# --- Observability -----------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
# Defaults to production/development from DEBUG; a blank value would report "".
# SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
