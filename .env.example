SECRET_KEY=django-insecure-change-this
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# AI provider settings. LLM_PROVIDER is the server-wide default
# (ollama | groq | gemini); requests may override it per-call with their
# own ai_provider choice.
LLM_PROVIDER=ollama
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: Docker Compose stores SQLite in its persistent backend-data volume.
# Leave unset for local development to use ./db.sqlite3.
SQLITE_DB_PATH=

# JWT Settings
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=7
